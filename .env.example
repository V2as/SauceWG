# ============================================================================
#  SauceWG — entry node (.env)
#  Copy to .env and fill in. Every value has a safe default except the ones
#  marked REQUIRED.
# ============================================================================

COMPOSE_PROJECT_NAME=saucewg

# --- images (change to your namespace before pushing to Docker Hub) ---------
IMAGE_AWG=saucewg/awg:1.3.0
IMAGE_PANEL=saucewg/panel:1.3.0
IMAGE_WEB=saucewg/web:1.3.0

# --- AmneziaWG legacy source refs ------------------------------------------
# The 0.2.x / 1.0.x lines are the legacy (AWG 1.x) protocol generation.
AWG_GO_REF=v0.2.19
AWG_TOOLS_REF=v1.0.20260618-2

# --- panel -----------------------------------------------------------------
PANEL_TITLE=SauceWG
# Host ports Caddy binds to. Use 80/443 if nothing else occupies them.
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=8443
# Leave as ":80" to serve plain HTTP on any hostname/IP (no domain needed).
# Set to a domain (e.g. panel.example.com) together with CADDY_AUTO_HTTPS=on
# to get an automatic Let's Encrypt certificate.
PANEL_SITE_ADDRESS=:80
# on | off, or one of Caddy's own auto_https values: disable_redirects,
# disable_certs, ignore_loaded_certs, prefer_wildcard. Anything else stops the
# web container at startup rather than serving the panel unprotected.
CADDY_AUTO_HTTPS=off
DOCS_ENABLED=true
LOG_LEVEL=info
DEBUG=false
CORS_ORIGINS=*

# --- authentication (REQUIRED) ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- database (REQUIRED) ---------------------------------------------------
POSTGRES_DB=saucewg
POSTGRES_USER=saucewg
POSTGRES_PASSWORD=

# --- entry interface (clients connect here) --------------------------------
AWG_IFACE=awg0
AWG_PORT=51820
AWG_SUBNET=10.8.0.0/24
AWG_MTU=1420
# REQUIRED: the public address clients dial. Usually the entry server's IP.
AWG_ENDPOINT_HOST=
# Leave the key blank to have one generated and persisted on first start.
AWG_PRIVATE_KEY=
#
# Which AmneziaWG generation this interface serves. The generation is not
# negotiated — it is decided by which parameters below are present, which is also
# how AmneziaVPN and KeeneticOS tell one profile from another:
#
#   1.0   Jc Jmin Jmax S1 S2 H1-H4          every KeeneticOS from 4.2 Alpha 2 on
#   1.5   the same, plus I1                 KeeneticOS 5.1 Alpha 3 and newer
#   2.0   the same, plus I1, S3 and S4      KeeneticOS 5.1 Alpha 3 and newer
#
# Leave blank to keep whatever the interface already recorded, so an upgrade never
# moves live clients to a generation their router cannot load. New interfaces
# default to 2.0. Changing this means every client config has to be re-imported.
AWG_PROTOCOL=
#
# Leave the obfuscation values blank to have a profile generated on first start and
# persisted. The parameters the chosen generation does not carry are cleared, so
# moving down from 2.0 to 1.0 really does stop advertising S3, S4 and I1.
#
# S1-S4 and H1-H4 must match on both ends of a tunnel; the panel copies them into
# every generated config. Jc/Jmin/Jmax and I1-I5 are built by the sender alone, so
# each end may use its own.
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
# 2.0 only: padding for the cookie reply and for transport packets. Left blank on this
# interface they default to 0, because the AmneziaVPN app does not pass non-zero S3/S4
# to its own backend: the handshake completes, then every transport packet the app
# sends is discarded as malformed, which looks like a tunnel that connects and carries
# nothing.
#   https://github.com/amnezia-vpn/amnezia-client/issues/2582
#
# The profile stays 2.0 — the parameters are still there, just carrying no padding —
# and routers using the AmneziaWG kernel module are unaffected either way. Pin a real
# value only if every client is a router. The cascade hop between nodes pads for real
# regardless, and that is the hop a censor actually sees.
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
# 1.5 and 2.0 only: a signature packet sent ahead of the handshake so a censor's
# classifier sees a protocol it already passes. Takes a preset name — quic, dns,
# random, short, none — or a literal spec such as `<b 0xdeadbeef><r 64>`.
# `saucewg signatures` prints what each preset looks like on the wire.
AWG_I1=
# Optional extra signature packets, same syntax.
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

# --- cascade uplinks (entry -> exit nodes) ---------------------------------
CASCADE_ENABLED=true
# Generation for an uplink whose exit node does not name one. Blank means 1.0, which
# is what an exit node installed before generations existed is serving.
CASCADE_PROTOCOL_DEFAULT=
CASCADE_MTU=1380
CASCADE_KEEPALIVE=25

# What happens to client traffic while every exit node is down:
#
#   direct  the entry node carries it itself until an exit node recovers. Clients
#           stay online, with this server's address, and are moved back onto the
#           cascade automatically. This is the default.
#   block   drop it. Nobody gets anywhere, but no traffic can appear from this
#           server's address either. The old CASCADE_KILLSWITCH=true.
#
# CASCADE_KILLSWITCH is still read when this is left empty, so an .env written
# before this setting existed keeps the behaviour it asked for.
CASCADE_FALLBACK=direct

# Exit nodes are a list, so any number of them can be configured. Each entry gets
# its own interface (awg1, awg2, ...), its own key and its own obfuscation profile,
# and all of them stay connected — a failover is only a route swap.
#
# Preferred: keep the list in config/exit-nodes.json (see config/exit-nodes.example.json).
# The panel writes the same file when a node is added from the UI, and the node
# container re-reads it within a second — no restart, no interruption.
CASCADE_NODES_FILE=/etc/amnezia/host/exit-nodes.json
# Alternative: inline the same JSON array here. Takes precedence over the file.
CASCADE_NODES_JSON=
# Uplink addresses default to <this subnet>.2, .3, .4 ... one per exit node.
CASCADE_UPLINK_SUBNET=10.77.0.0/24

# Destinations that skip the cascade and leave through this entry node instead —
# for services that must see a local address, or that are better off not crossing
# the exit node at all.
#
# Preferred: keep the list in config/direct-routes.json (see the example file);
# the panel edits it and the node container applies changes within a second.
CASCADE_DIRECT_FILE=/etc/amnezia/host/direct-routes.json
# Alternative: a comma- or space-separated list here. Takes precedence over the
# file. IPv4 addresses and CIDR ranges only — names are not resolved.
CASCADE_DIRECT_ROUTES=

# Destinations that are blocked at the point where a TCP connection is established:
# the SYN to their IPv4 is dropped, so nothing ever connects, while ICMP and every
# already-established flow pass. A route cannot fix that, so CASCADE_DIRECT_ROUTES
# cannot either — this entry node opens the outbound half itself, over the
# destination's IPv6 where one is known and by dialling its IPv4 until a handshake
# lands otherwise.
#
#   auto    engage only while client traffic is leaving through this entry node,
#           which is when the filter in front of it applies to clients (default)
#   always  engage whether or not an exit node is carrying client traffic
#   off     do not engage; blocked destinations stay blocked
BYPASS_MODE=auto
# Destinations this release ships a table for. Currently only `telegram`, which
# covers the datacenter addresses the official clients dial and their IPv6
# counterparts. Empty disables the built-in table without disabling the feature.
BYPASS_GROUPS=telegram
# Anything else, or a correction to a group entry: a JSON array of
# {"cidr": "…", "v6": "…", "note": "…", "enabled": true}. `v6` is optional and the
# destination's own IPv4 is retried without it. See: saucewg bypass
BYPASS_FILE=/etc/amnezia/host/bypass.json
# Alternative: a comma- or space-separated list of prefixes here, with no IPv6
# counterparts. Takes precedence over the file.
BYPASS_ROUTES=
# Where the relay listens. Bound to the server's address on the client interface
# only, so it is not reachable from outside the tunnel.
BYPASS_PORT=8646
# How hard to dial a destination whose handshakes are being dropped: the budget for
# one connection, and how many handshakes are outstanding at once. The filter samples
# handshakes rather than dropping all of them, so each is an independent attempt —
# going several at a time is what makes a connection take under a second instead of
# ten. Raise PARALLEL on a network dropping more than this copes with; each attempt
# in flight costs an ephemeral port and a conntrack entry.
BYPASS_ATTEMPTS=96
BYPASS_PARALLEL=6

# Failover. An uplink is dropped after FAIL_THRESHOLD consecutive bad checks and
# taken back after RECOVER_THRESHOLD good ones; with the defaults an outage is
# noticed in about 30 seconds.
CASCADE_PROBE_ENABLED=true
CASCADE_PROBE_TARGET=1.1.1.1
CASCADE_PROBE_INTERVAL=10
CASCADE_PROBE_TIMEOUT=3
CASCADE_FAIL_THRESHOLD=3
CASCADE_RECOVER_THRESHOLD=2
# An uplink whose last handshake is older than this is considered dead outright.
CASCADE_HANDSHAKE_TIMEOUT=180

# --- single exit node (used only when no node list is configured) -----------
CASCADE_ENDPOINT=
CASCADE_ADDRESS=
CASCADE_PEER_PUBLIC_KEY=
CASCADE_PEER_PSK=
# The generation that exit node serves. Blank means 1.0.
CASCADE_PROTOCOL=
CASCADE_JC=
CASCADE_JMIN=
CASCADE_JMAX=
CASCADE_S1=
CASCADE_S2=
CASCADE_S3=
CASCADE_S4=
CASCADE_H1=
CASCADE_H2=
CASCADE_H3=
CASCADE_H4=
CASCADE_I1=
CASCADE_I2=
CASCADE_I3=
CASCADE_I4=
CASCADE_I5=

# --- generated client profiles ---------------------------------------------
CLIENT_DNS=1.1.1.1, 1.0.0.1
CLIENT_MTU=1280
CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
CLIENT_KEEPALIVE=25
# Junk-packet profile handed to clients; 0 means "reuse the server's values".
CLIENT_JC=0
CLIENT_JMIN=0
CLIENT_JMAX=0
# Signature packet handed to clients on 1.5 and 2.0. Blank mirrors the server's own.
# Worth setting when clients sit behind a censor that drops the server's disguise —
# it is sender-side, so the two ends need not match.
CLIENT_SIGNATURE=

# --- workers ---------------------------------------------------------------
COLLECTOR_INTERVAL_SECONDS=10
SYNC_INTERVAL_SECONDS=30
ONLINE_TIMEOUT_SECONDS=180
USAGE_BUCKET_MINUTES=60
USAGE_RETENTION_DAYS=90

# Public base URL used in subscription links; defaults to the request host.
SUBSCRIPTION_URL_PREFIX=

# --- exit node provisioning -------------------------------------------------
# The panel's read-write view of config/exit-nodes.json. Adding a node from the UI
# installs Docker and AmneziaWG on that server over SSH, writes it into this file
# and pairs both ends. Root credentials are used once and never stored.
NODE_REGISTRY_FILE=/etc/saucewg/host/exit-nodes.json
# The panel's read-write view of the two destination lists in the same directory:
# config/direct-routes.json (which way out a destination takes) and
# config/bypass.json (destinations no way out reaches, because the handshake to them
# is what is being dropped).
ROUTES_REGISTRY_FILE=/etc/saucewg/host/direct-routes.json
BYPASS_REGISTRY_FILE=/etc/saucewg/host/bypass.json
# Set to false to make the panel read-only with respect to the cascade.
NODE_PROVISION_ENABLED=true
NODE_DEFAULT_PORT=51820
# A cold install pulls Docker and the node image; allow for a slow VPS.
NODE_SSH_TIMEOUT_SECONDS=900
# Ceiling for the calls that answer inside one request: status, logs, check.
NODE_SSH_QUERY_TIMEOUT_SECONDS=60

# The panel keeps an SSH key pair of its own and enrols the public half on every
# node it installs, so that restarting, upgrading, repairing or removing a node
# afterwards needs no root password. Publish the public half with
# GET /api/nodes/ssh-key and inject it into a new server at creation time to
# install one without a password at all. Set NODE_SSH_KEY_ENABLED=false to keep
# the old behaviour, where every call carries credentials.
NODE_SSH_KEY_FILE=/etc/saucewg/host/panel-ssh-key
NODE_SSH_KEY_ENABLED=true

# The cascade fails over within about 30 seconds and leaves the failed node down —
# nothing is broken for a client, so it can stay down until the last node goes with
# it. The panel is the only part of the installation that can reach an exit server,
# so it tries to put it back with the key above: probe it, restart its service, and
# re-install the uplink key if the tunnel still does not handshake. A server that
# does not answer SSH at all is left alone and reported instead — that is a deleted
# VPS rather than a broken service. `saucewg recover` runs the same escalation now.
NODE_RECOVERY_ENABLED=true
# Nothing is done for this long, so a reload or a reboot is not chased.
NODE_RECOVERY_GRACE_SECONDS=300
# How often the fleet is swept, and the base for the geometric backoff between
# attempts at the same node.
NODE_RECOVERY_INTERVAL_SECONDS=60
NODE_RECOVERY_MAX_ATTEMPTS=6

# Where a node installed from the UI gets its installer and images from. A new
# exit node has to *pull* its image, so these name the published repository —
# unlike IMAGE_* above, which this compose file builds locally when absent. Point
# them at your own fork and namespace, and keep the tag in step with IMAGE_AWG,
# if you publish your own builds.
SAUCEWG_REPO=V2as/SauceWG
SAUCEWG_REF=main
SAUCEWG_NAMESPACE=v2as
SAUCEWG_IMAGE_PREFIX=saucewg-
SAUCEWG_TAG=1.3.0
