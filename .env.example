# ============================================================================
#  SauceWG — entry node (.env)
#  Copy to .env and fill in. Every value has a safe default except the ones
#  marked REQUIRED.
# ============================================================================

COMPOSE_PROJECT_NAME=saucewg

# --- images (change to your namespace before pushing to Docker Hub) ---------
IMAGE_AWG=saucewg/awg:1.1.0
IMAGE_PANEL=saucewg/panel:1.1.0
IMAGE_WEB=saucewg/web:1.1.0

# --- AmneziaWG legacy source refs ------------------------------------------
# The 0.2.x / 1.0.x lines are the legacy (AWG 1.x) protocol generation.
AWG_GO_REF=v0.2.19
AWG_TOOLS_REF=v1.0.20260618-2

# --- panel -----------------------------------------------------------------
PANEL_TITLE=SauceWG
# Host ports Caddy binds to. Use 80/443 if nothing else occupies them.
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=8443
# Leave as ":80" to serve plain HTTP on any hostname/IP (no domain needed).
# Set to a domain (e.g. panel.example.com) together with CADDY_AUTO_HTTPS=on
# to get an automatic Let's Encrypt certificate.
PANEL_SITE_ADDRESS=:80
CADDY_AUTO_HTTPS=off
DOCS_ENABLED=true
LOG_LEVEL=info
DEBUG=false
CORS_ORIGINS=*

# --- authentication (REQUIRED) ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- database (REQUIRED) ---------------------------------------------------
POSTGRES_DB=saucewg
POSTGRES_USER=saucewg
POSTGRES_PASSWORD=

# --- entry interface (clients connect here) --------------------------------
AWG_IFACE=awg0
AWG_PORT=51820
AWG_SUBNET=10.8.0.0/24
AWG_MTU=1420
# REQUIRED: the public address clients dial. Usually the entry server's IP.
AWG_ENDPOINT_HOST=
# Leave the key blank to have one generated and persisted on first start.
AWG_PRIVATE_KEY=
# Leave the obfuscation values blank to generate a random legacy profile.
# S1/S2 and H1-H4 must match between server and client; the panel copies them
# into every generated config automatically.
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=

# --- cascade uplinks (entry -> exit nodes) ---------------------------------
CASCADE_ENABLED=true
CASCADE_MTU=1380
CASCADE_KEEPALIVE=25
# Drop client traffic when every uplink is down instead of leaking via the entry IP.
CASCADE_KILLSWITCH=true

# Exit nodes are a list, so any number of them can be configured. Each entry gets
# its own interface (awg1, awg2, ...), its own key and its own obfuscation profile,
# and all of them stay connected — a failover is only a route swap.
#
# Preferred: keep the list in config/exit-nodes.json (see config/exit-nodes.example.json).
CASCADE_NODES_FILE=/etc/amnezia/host/exit-nodes.json
# Alternative: inline the same JSON array here. Takes precedence over the file.
CASCADE_NODES_JSON=
# Uplink addresses default to <this subnet>.2, .3, .4 ... one per exit node.
CASCADE_UPLINK_SUBNET=10.77.0.0/24

# Failover. An uplink is dropped after FAIL_THRESHOLD consecutive bad checks and
# taken back after RECOVER_THRESHOLD good ones; with the defaults an outage is
# noticed in about 30 seconds.
CASCADE_PROBE_ENABLED=true
CASCADE_PROBE_TARGET=1.1.1.1
CASCADE_PROBE_INTERVAL=10
CASCADE_PROBE_TIMEOUT=3
CASCADE_FAIL_THRESHOLD=3
CASCADE_RECOVER_THRESHOLD=2
# An uplink whose last handshake is older than this is considered dead outright.
CASCADE_HANDSHAKE_TIMEOUT=180

# --- single exit node (legacy, used only when no node list is configured) ---
CASCADE_ENDPOINT=
CASCADE_ADDRESS=
CASCADE_PEER_PUBLIC_KEY=
CASCADE_PEER_PSK=
CASCADE_JC=
CASCADE_JMIN=
CASCADE_JMAX=
CASCADE_S1=
CASCADE_S2=
CASCADE_H1=
CASCADE_H2=
CASCADE_H3=
CASCADE_H4=

# --- generated client profiles ---------------------------------------------
CLIENT_DNS=1.1.1.1, 1.0.0.1
CLIENT_MTU=1280
CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
CLIENT_KEEPALIVE=25
# Junk-packet profile handed to clients; 0 means "reuse the server's values".
CLIENT_JC=0
CLIENT_JMIN=0
CLIENT_JMAX=0

# --- workers ---------------------------------------------------------------
COLLECTOR_INTERVAL_SECONDS=10
SYNC_INTERVAL_SECONDS=30
ONLINE_TIMEOUT_SECONDS=180
USAGE_BUCKET_MINUTES=60
USAGE_RETENTION_DAYS=90

# Public base URL used in subscription links; defaults to the request host.
SUBSCRIPTION_URL_PREFIX=
