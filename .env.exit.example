# ============================================================================
#  SauceWG — exit node (.env)
#  Deployed with: docker compose -f docker-compose.exit.yml up -d
# ============================================================================

COMPOSE_PROJECT_NAME=saucewg-exit
IMAGE_AWG=saucewg/awg:1.3.0

AWG_GO_REF=v0.2.19
AWG_TOOLS_REF=v1.0.20260618-2

AWG_IFACE=awg0
AWG_PORT=51820
# Transit subnet shared with the entry node.
AWG_SUBNET=10.77.0.0/24
AWG_MTU=1420
AWG_PRIVATE_KEY=

# Which AmneziaWG generation this node serves: 1.0, 1.5 or 2.0. Blank keeps whatever
# the interface already recorded, and a brand new one starts on 2.0.
#
#   1.0   Jc Jmin Jmax S1 S2 H1-H4          every KeeneticOS from 4.2 Alpha 2 on
#   1.5   the same, plus I1                 KeeneticOS 5.1 Alpha 3 and newer
#   2.0   the same, plus I1, S3 and S4      KeeneticOS 5.1 Alpha 3 and newer
AWG_PROTOCOL=

# Obfuscation profile; blank values are generated on first start. Whatever ends up
# here must be mirrored into this node's entry in the entry node's
# config/exit-nodes.json — `saucewg node-info` prints exactly that object.
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
# 2.0 only. The peer here is always the entry node's amneziawg-go, which handles these
# correctly, so blank values generate real padding — unlike a client-facing interface,
# which defaults them to 0 to work around a bug in the AmneziaVPN app.
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
# 1.5 and 2.0 only: preset name (quic, dns, random, short, none) or a literal spec.
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

# The entry node, as seen from here. Each of the entry node's uplinks terminates on
# its own address in the transit subnet, so accepting the whole range keeps this
# node usable in any slot of its exit node list.
AWG_PEER_PUBLIC_KEY=
AWG_PEER_PSK=
AWG_PEER_ALLOWED_IPS=10.77.0.0/24

# Leave blank to auto-detect the interface holding the default route.
WAN_IFACE=

# BitTorrent, blocked in the traffic this node forwards. This is the server a swarm
# sees and the one a datacentre suspends over a copyright notice, so the guard is
# worth having here even when the entry node in front of it already runs one: what
# arrives over the uplink is still in the clear on this side.
#
#   off     forward it like anything else
#   on      block discovery (DHT, trackers, PEX, LSD) and the peer wire, and
#           blacklist every address caught speaking it
#   strict  the above, plus outbound TCP and UDP only to the ports below
#
# Blank takes the setting from config/torrent-block.json instead, which is what
# `saucewg torrents` writes and what applies without recreating the container.
TORRENT_BLOCK=
TORRENT_BLOCK_FILE=/etc/amnezia/host/torrent-block.json
# What `strict` still allows out. Blank means the built-in lists.
TORRENT_TCP_PORTS=
TORRENT_UDP_PORTS=
