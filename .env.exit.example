# ============================================================================
#  SauceWG — exit node (.env)
#  Deployed with: docker compose -f docker-compose.exit.yml up -d
# ============================================================================

COMPOSE_PROJECT_NAME=saucewg-exit
IMAGE_AWG=saucewg/awg:1.0.0

AWG_GO_REF=v0.2.19
AWG_TOOLS_REF=v1.0.20260618-2

AWG_IFACE=awg0
AWG_PORT=51820
# Transit subnet shared with the entry node.
AWG_SUBNET=10.77.0.0/24
AWG_MTU=1420
AWG_PRIVATE_KEY=

# Obfuscation profile; blank values are generated on first start. Whatever ends
# up here must be mirrored into the entry node's CASCADE_* variables.
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=

# The entry node, as seen from here.
AWG_PEER_PUBLIC_KEY=
AWG_PEER_PSK=
AWG_PEER_ALLOWED_IPS=10.77.0.2/32

# Leave blank to auto-detect the interface holding the default route.
WAN_IFACE=
